# Copiar a backend/.env. Introducir la URI real SOLO en ese archivo local.
# Sustituir los marcadores con datos de Atlas; codificar caracteres especiales
# del usuario y contraseña con percent-encoding. No compartir ni subir la URI.
MONGODB_URI=
# La aplicación usa esta base explícitamente, incluso si la URI contiene otra.
MONGODB_DB=GymWeb
# Opcional si el DNS de la red bloquea Atlas. Vacío usa el DNS del sistema.
# Ejemplo: MONGODB_DNS_SERVERS=1.1.1.1,1.0.0.1
MONGODB_DNS_SERVERS=
HOST=127.0.0.1
PORT=3000
# Solo en el hosting (Render): 1 = confiar en su proxy HTTPS. En local, 0.
TRUST_PROXY=0
# Opcional: otros sitios que pueden llamar a la API (CORS), separados por comas.
# Vacío = solo el mismo origen. Ejemplo: CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=
# Carpeta de los comprobantes PDF. Vacío = backend/almacenamiento/. En Render el disco es efímero:
# si un PDF se pierde, el backend lo regenera con los datos guardados y comprueba su SHA-256.
ALMACENAMIENTO_DIR=
